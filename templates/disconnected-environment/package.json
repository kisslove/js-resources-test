{
  "name": "disconnected-environment-template",
  "description": "GeoScene Maps SDK for JavaScript disconnected environment Vite template",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run copy:all && vite",
    "build": "npm run copy:all && vite build",
    "preview": "vite preview",
    "copy:all": "npm run copy:calcite && npm run copy:core && npm run copy:components",
    "copy:calcite": "cpx \"node_modules/@geoscene/calcite-components/dist/cdn/assets/**/*.*\" ./public/assets",
    "copy:core": "cpx \"node_modules/@geoscene/core/assets/**/*.*\" ./public/assets",
    "copy:components": "cpx \"node_modules/@geoscene/coding-components/dist/cdn/assets/**/*.*\" ./public/assets && cpx \"node_modules/@geoscene/map-components/dist/cdn/assets/**/*.*\" ./public/assets && cpx \"node_modules/@geoscene/charts-components/dist/cdn/assets/**/*.*\" ./public/assets && cpx \"node_modules/@geoscene/common-components/dist/cdn/assets/**/*.*\" ./public/common-components/assets"
  },
  "dependencies": {
    "@geoscene/charts-components": "^5.1.0",
    "@geoscene/coding-components": "^5.1.0",
    "@geoscene/common-components": "^5.1.0",
    "@geoscene/core": "^5.1.0",
    "@geoscene/map-components": "^5.1.0",
    "@geoscene/calcite-components": "^5.1.1"
  },
  "devDependencies": {
    "cpx2": "^8.0.0",
    "vite": "^8.0.16"
  }
}
